{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pchelovod63-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-10-13",
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_ROOM",
        "class_name": "ChatRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRoom"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://komahdop-ctrl.github.io,https://pchelovod63.ru,https://www.pchelovod63.ru"
  }
}
